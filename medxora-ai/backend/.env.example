# Copy this file to .env and fill in your values

# REQUIRED: Gemini API key for AI Mission Control (all agent reasoning uses this)
# Get one free at https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: MongoDB connection URI for MCP memory (falls back to local SQLite if not set)
# Example: mongodb+srv://user:pass@cluster.mongodb.net/medxora_ai
MONGODB_URI=

# Optional: path to MetaTrader 5 terminal executable
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Optional: path to the MT5 data folder that contains MQL5/ (auto-detected if not set).
# Normal mode example:  MT5_DATA_DIR=C:\Users\YourName\AppData\Roaming\MetaQuotes\Terminal\D0E8209F77C8CF37AD8BF550E51FF075
# Portable mode example: MT5_DATA_DIR=C:\Program Files\MetaTrader 5
MT5_DATA_DIR=

# Optional: path to an exported MT5 tick-data CSV for readiness checks and future dataset-driven workflows.
MT5_TICK_DATA_PATH=C:\Users\YourName\Desktop\MedXora AI\DATA\EURUSD_202001020600_202604291148.csv

# Optional: browser origins allowed to call the API.
# Comma-separated list. Default is local Vite dev/preview only.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Optional: override SQLite DB location
# DATABASE_URL=sqlite:///./medxora.db
